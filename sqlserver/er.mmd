erDiagram
    symptom ||--o{ symptom_sign : "1 個症狀有多項徵兆"
    symptom ||--o{ symptom_body_part : "1 個症狀對應多個部位"
    body_part ||--o{ symptom_body_part : "1 個部位屬於多個症狀"
    symptom ||--o{ symptom_source : "1 個症狀引用多個來源"
    source ||--o{ symptom_source : "1 個來源支援多個症狀"

    symptom {
        BIGINT id PK "症狀編號"
        VARCHAR code UK "代碼"
        NVARCHAR name "名稱"
        VARCHAR category "分類"
        VARCHAR severity "嚴重程度"
        NVARCHAR summary "簡介"
        NVARCHAR when_to_see_doctor "就醫時機"
        VARCHAR status "狀態"
        NVARCHAR reviewed_by "審閱者"
        DATE reviewed_at "審閱日期"
        DATETIME2 created_at "建立時間"
        DATETIME2 updated_at "修改時間"
        NVARCHAR updated_by "修改者"
        BIGINT version "版本號"
    }
    symptom_sign {
        BIGINT symptom_id PK,FK "症狀編號"
        INT sort_order PK "順序"
        NVARCHAR content "徵兆內容"
    }
    symptom_body_part {
        BIGINT symptom_id PK,FK "症狀編號"
        VARCHAR part_code PK,FK "部位代碼"
    }
    body_part {
        VARCHAR code PK "部位代碼"
        NVARCHAR name "部位名稱"
        INT sort_order "排序"
    }
    audit_log {
        BIGINT id PK "紀錄編號"
        DATETIME2 occurred_at "發生時間"
        NVARCHAR username "帳號"
        VARCHAR action "動作"
        VARCHAR target "對象症狀代碼"
        NVARCHAR detail "內容"
        VARCHAR ip_address "IP"
    }
    source {
        INT id PK "來源編號"
        VARCHAR code UK "代碼"
        NVARCHAR title "標題"
        NVARCHAR publisher "發布單位"
        NVARCHAR author "作者"
        VARCHAR source_type "類型"
        NVARCHAR url "網址"
        NVARCHAR published "發布時間"
        DATE accessed_date "查閱日期"
        NVARCHAR note "備註"
    }
    symptom_source {
        BIGINT symptom_id PK,FK "症狀編號"
        INT source_id PK,FK "來源編號"
    }
